# =====================================================================
# KnowSphere AI — example environment configuration
# Copy to `.env` and adjust. NEVER commit the real `.env` file.
# The default workflow requires NO paid API key: Ollama runs locally.
# =====================================================================

# --- Active LLM provider: "ollama" (default, local, free)
#     or "openrouter" (cloud, optional key)
LLM_PROVIDER=ollama

# --- Ollama (local inference) ---
# Install from https://ollama.com and run:  ollama pull llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1:8b

# --- OpenRouter (optional cloud access, includes free models) ---
# Get a key at https://openrouter.ai — leave empty to stay key-free.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Free-tier eligible example model:
OPENROUTER_CHAT_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Embeddings (local, runs on CPU by default) ---
# embedding_provider: "sentence-transformers" (default) or "fake" (offline tests)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu

# --- Storage ---------------------------------------------------------
# Root directory for runtime data (resolved against the project root
# when relative). Sub-paths derived from it:
#   <DATA_DIR>/uploads/    raw documents
#   <DATA_DIR>/chroma/     ChromaDB persistent vector index
#   <DATA_DIR>/knowsphere.db
DATA_DIR=data

# --- ingestion -------------------------------------------------------
MAX_UPLOAD_BYTES=20971520     # 20 MB per document
CHUNK_MAX_CHARS=1000
CHUNK_OVERLAP_CHARS=200

# --- retrieval & chat (M4) -------------------------------------------
RETRIEVAL_TOP_K=5             # chunks fetched per question (per-request override supported)
MIN_SIMILARITY=0.30           # cosine-similarity floor; lower = more permissive
CHAT_HISTORY_MESSAGES=8       # recent turns included in the LLM prompt

# --- production frontend serving (M6, optional) -----------------------
# When 1 (and frontend/dist exists after `npm run build`), the backend
# serves the built React app itself on port 8000. Keep 0 for development.
SERVE_FRONTEND=0
FRONTEND_DIST_DIR=frontend/dist

# --- CORS ------------------------------------------------------------
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173
